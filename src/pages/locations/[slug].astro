---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import HeroShowcaseImage from '../../components/HeroShowcaseImage.astro';
import ContentImage from '../../components/ContentImage.astro';
import siteConfig from '../../data/site-config.json';
import neighborhoodsList from '../../data/neighborhoods-list.json';
import { allNeighborhoodsData } from '../../data/neighborhoods/index';

export async function getStaticPaths() {
  return neighborhoodsList.map((neighborhood) => ({
    params: { slug: neighborhood.slug },
    props: {
      data: allNeighborhoodsData[neighborhood.slug],
    },
  }));
}

const { data } = Astro.props;

const canonicalUrl = `${siteConfig.domain}/locations/${data.slug}/`;

// Schemas
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "name": `${siteConfig.businessName} - ${data.name}`,
  "image": `${siteConfig.domain}/images/hero.jpg`,
  "telephone": siteConfig.phone,
  "url": canonicalUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.state,
    "postalCode": data.zip,
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.geo.latitude,
    "longitude": siteConfig.geo.longitude
  },
  "areaServed": {
    "@type": "Place",
    "name": `${data.name}, Los Gatos, CA`,
    "postalCode": data.zip
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "priceRange": "$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "48"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.domain
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Locations",
      "item": `${siteConfig.domain}/locations/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": data.name,
      "item": canonicalUrl
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const neighborhoodImageSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "contentUrl": `${siteConfig.domain}/images/los-gatos-residential-ev-charger-installation-electrician.jpg`,
  "url": `${siteConfig.domain}/images/los-gatos-residential-ev-charger-installation-electrician.jpg`,
  "name": `EV Charger Repair & Diagnostic Electricians Serving ${data.name}, Los Gatos`,
  "description": `Licensed C-10 electrician repairing and testing Level 2 EV charging stations across ${data.name} in Los Gatos, CA.`,
  "caption": `Professional EV Charger Repair in ${data.name}, Los Gatos`,
  "width": 1280,
  "height": 720
};
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={[localBusinessSchema, breadcrumbSchema, faqSchema, neighborhoodImageSchema]}
>
  <!-- Hero Section -->
  <section class="neighborhood-hero">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/locations/">Locations</a></li>
          <li aria-current="page">{data.name}</li>
        </ol>
      </nav>

      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>{data.name} • Los Gatos, CA {data.zip}</span>
          </div>
          <h1>{data.h1}</h1>
          <p class="hero-sublead">{data.heroSubheadline}</p>
          <p class="hero-opening">{data.openingText}</p>

          <div class="hero-actions">
            <a href="#quote-form" class="btn btn-lime-teal btn-lg">
              Get a Quote
            </a>
            <a href={`tel:${siteConfig.phone}`} class="btn btn-outline-white btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call {siteConfig.phoneFormatted}
            </a>
          </div>
        </div>

        <HeroShowcaseImage
          alt={`EV Charger Repair and Diagnostics in ${data.name}, Los Gatos CA`}
          title={`EV Charger Services in ${data.name}, Los Gatos, CA`}
          badgeText={`${data.name} • Dedicated EV Electricians`}
        />
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- About Company Summary -->
  <section class="about-summary-section">
    <div class="container">
      <div class="summary-box">
        <div class="summary-text">
          <span class="section-badge">Local Electricians</span>
          <h2>Dedicated EV Electrical Services in {data.name}</h2>
          <p>
            Los Gatos EV Charger Pros provides certified electrical repair, diagnostic troubleshooting, and code-compliant panel upgrades across {data.name} and the greater Los Gatos area. Operating under California C-10 Electrical Contractor License #1048291, our journeyman electricians specialize in high-amperage residential charging, commercial Level 2 stations, and Tesla Wall Connector systems.
          </p>
          <p>
            With our primary office located at 14165 Capri Drive in Los Gatos, we are positioned to provide rapid same-day diagnostics, manage local Town of Los Gatos building permits, and ensure every circuit meets stringent National Electrical Code continuous-duty standards.
          </p>
        </div>
        <div class="summary-stats">
          <div class="stat-card">
            <span class="stat-number">100%</span>
            <span class="stat-label">Town Permit Pass Rate</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">48A</span>
            <span class="stat-label">Max Level 2 Speed</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">C-10</span>
            <span class="stat-label">State License #1048291</span>
          </div>
        </div>
      </div>

      <!-- In-Content Local Dispatch Showcase -->
      <ContentImage
        src="/images/los-gatos-residential-ev-charger-installation-electrician.jpg"
        alt={`Licensed Electrician Repairing and Testing EV Charger in ${data.name}, Los Gatos, CA`}
        title={`EV Charger Repair & Diagnostic Electrician in ${data.name}`}
        caption={`Certified C-10 electrician diagnosing a dedicated Level 2 home charging station and verifying circuit safety across residential properties in ${data.name}.`}
        badge={`${data.name} • Certified EV Charger Repair`}
      />
    </div>
  </section>

  <!-- Housing Profile & Electrical Infrastructure -->
  <section class="housing-profile-section bg-light">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Local Area Insights</span>
        <h2>{data.housingProfile.title}</h2>
      </div>
      <div class="housing-content">
        {data.housingProfile.paragraphs.map((para) => (
          <p class="content-paragraph">{para}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Services Grid -->
  <section class="services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Specialized Services</span>
        <h2>EV Charging Solutions Featured for {data.name}</h2>
        <p class="section-subtitle">
          Engineered specifically for the electrical profiles and architectural configurations found in {data.name}, Los Gatos.
        </p>
      </div>

      <div class="services-grid">
        {data.featuredServices.map((service) => (
          <article class="service-card">
            <div class="service-icon">⚡</div>
            <h3 class="service-title">
              <a href={`/services/${service.slug}/`}>{service.name}</a>
            </h3>
            <p class="service-desc">{service.desc}</p>
            <a href={`/services/${service.slug}/`} class="service-link">
              <span>Learn More About {service.name}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications & Accreditation Banner -->
  <section class="certifications-banner">
    <div class="container">
      <div class="cert-wrapper">
        <span class="cert-title">Certified & Compliant With:</span>
        <div class="cert-badges">
          <div class="cert-badge-item">California C-10 Electrical #1048291</div>
          <div class="cert-badge-item">Tesla Certified Wall Connector Installers</div>
          <div class="cert-badge-item">Town of Los Gatos Building Division</div>
          <div class="cert-badge-item">NEC Article 625 & Title 24 Compliant</div>
          <div class="cert-badge-item">PG&E Service Planning Coordinated</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Dive Topical Technical Coverage -->
  <section class="deep-dive-section">
    <div class="container">
      {data.deepDiveContent.map((section) => (
        <div class="deep-dive-block">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((para) => (
            <p class="content-paragraph">{para}</p>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="common-problems-section bg-light">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Diagnostics & Troubleshooting</span>
        <h2>Common EV Charger Issues We Resolve in {data.name}</h2>
        <p class="section-subtitle">
          Electrical failures can halt your daily routine. We diagnose and repair every component from breaker box to charging port.
        </p>
      </div>

      <div class="problems-grid">
        {data.commonProblems.map((prob) => (
          <div class="problem-card">
            <div class="problem-icon">⚠️</div>
            <h3>{prob.title}</h3>
            <p>{prob.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="why-choose-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">The Local Difference</span>
        <h2>Why Choose Los Gatos EV Charger Pros in {data.name}</h2>
        <p class="section-subtitle">
          Six foundational standards that set our residential and commercial electrical services apart.
        </p>
      </div>

      <div class="why-grid">
        <div class="why-item">
          <span class="why-num">01</span>
          <h3>California C-10 Licensed Electricians</h3>
          <p>Directly employed master and journeyman electricians, not unvetted sub-contractors or general handymen.</p>
        </div>
        <div class="why-item">
          <span class="why-num">02</span>
          <h3>Local Los Gatos Dispatch</h3>
          <p>Dispatched from 14165 Capri Drive for rapid response across all {data.name} streets and adjacent mountain pockets.</p>
        </div>
        <div class="why-item">
          <span class="why-num">03</span>
          <h3>Complete Town Permitting</h3>
          <p>We draft engineering single-lines and coordinate directly with Town of Los Gatos inspectors for seamless municipal sign-offs.</p>
        </div>
        <div class="why-item">
          <span class="why-num">04</span>
          <h3>Aesthetic Conduit Routing</h3>
          <p>Concealed crawlspace runs, custom painted raceways, and historic-friendly trenching that preserves curb appeal.</p>
        </div>
        <div class="why-item">
          <span class="why-num">05</span>
          <h3>Brand-Certified Knowledge</h3>
          <p>Extensive experience with Tesla Wall Connectors, ChargePoint Home Flex, Rivian, Enel X, and commercial pedestal chargers.</p>
        </div>
        <div class="why-item">
          <span class="why-num">06</span>
          <h3>Transparent Written Proposals</h3>
          <p>Written, line-item specifications detailing wire gauge, breaker models, labor hours, and permits with zero surprise charges.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Solutions & Scopes -->
  <section class="pricing-section bg-light">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Service Solutions</span>
        <h2>{data.pricingTransparency.title}</h2>
        <p class="section-subtitle">{data.pricingTransparency.lead}</p>
      </div>

      <div class="pricing-grid">
        {data.pricingTransparency.tiers.map((tier) => (
          <div class="pricing-card">
            <h3 class="tier-name">{tier.name}</h3>
            <p class="tier-desc">{tier.description}</p>
            <a href="#quote-form" class="btn btn-outline btn-sm">Request Proposal</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Service Process -->
  <section class="process-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">How We Work</span>
        <h2>Our 5-Step EV Charger Diagnostic & Repair Workflow</h2>
        <p class="section-subtitle">
          A seamless, predictable process ensuring safety, durability, and full code compliance in {data.name}.
        </p>
      </div>

      <div class="process-timeline">
        {data.serviceProcess.map((step) => (
          <div class="timeline-step">
            <div class="step-badge">{step.step}</div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local Streets & Landmarks -->
  <section class="landmarks-section bg-light">
    <div class="container">
      <div class="landmarks-box">
        <span class="section-badge">Local Coverage Detail</span>
        <h2>Streets & Landmarks We Service in {data.name}</h2>
        <p class="landmarks-desc">{data.localStreetsAndLandmarks.description}</p>
        
        <div class="landmarks-columns">
          <div class="landmark-col">
            <h3>Key Streets & Thoroughfares</h3>
            <ul class="clean-list">
              {data.localStreetsAndLandmarks.streets.map((st) => (
                <li>{st}</li>
              ))}
            </ul>
          </div>
          <div class="landmark-col">
            <h3>Notable Local Landmarks & Hubs</h3>
            <ul class="clean-list">
              {data.localStreetsAndLandmarks.landmarks.map((lm) => (
                <li>{lm}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Testimonials -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Verified Reviews</span>
        <h2>What Your Neighbors in {data.name} Say About Our Work</h2>
        <p class="section-subtitle">Real feedback from local homeowners who rely on our certified electrical team.</p>
      </div>

      <div class="testimonials-grid">
        {data.testimonials.map((review) => (
          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">"{review.text}"</p>
            <div class="review-meta">
              <strong>{review.author}</strong>
              <span>{review.street}</span>
              <span class="review-date">{review.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby Neighborhoods -->
  <section class="nearby-section bg-light">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Explore Surrounding Areas</span>
        <h2>Nearby Los Gatos Neighborhoods We Serve</h2>
        <p class="section-subtitle">
          Discover our dedicated EV electrical services in adjacent communities throughout Los Gatos.
        </p>
      </div>

      <div class="nearby-grid">
        {data.nearbyNeighborhoods.map((nearby) => (
          <div class="nearby-card">
            <h3>
              <a href={`/locations/${nearby.slug}/`}>{nearby.name}</a>
            </h3>
            <p>{nearby.note}</p>
            <a href={`/locations/${nearby.slug}/`} class="nearby-link">
              View {nearby.name} EV Services →
            </a>
          </div>
        ))}
      </div>

      <div class="all-locations-btn-wrap text-center">
        <a href="/locations/" class="btn btn-outline">
          Explore All 25 Los Gatos Neighborhoods →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Common Questions</span>
        <h2>Frequently Asked Questions About EV Charging in {data.name}</h2>
        <p class="section-subtitle">Practical advice from our licensed Los Gatos electrical contractors.</p>
      </div>

      <div class="faq-accordion">
        {data.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.q}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Urgent High-Impact CTA Band -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>Ready to Charge at Full Speed in {data.name}?</h2>
        <p>Contact our licensed electricians today for same-day diagnostics, upfront proposals, and professional repair.</p>
      </div>
      <div class="cta-btns">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-white btn-lg">
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="#quote-form" class="btn btn-outline-white btn-lg">
          Request Service Consultation
        </a>
      </div>
    </div>
  </section>

  <!-- Contact & Map Section -->
  <section class="contact-section" id="quote-form">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-cta-panel">
          <span class="section-badge">Direct Electrician Dispatch</span>
          <h2>Ready for Fast EV Charger Service in {data.name}?</h2>
          <p>Skip the waiting queues and paperwork. Connect immediately with our certified Los Gatos electrical technicians for rapid troubleshooting, Tesla connector repair, or residential Level 2 charging setup.</p>
          
          <div class="direct-call-card">
            <div class="dcc-header">
              <span class="dcc-label">Immediate Phone Consultation & Dispatch</span>
              <a href={`tel:${siteConfig.phone}`} class="dcc-phone">{siteConfig.phoneFormatted}</a>
              <span class="dcc-sub">Serving all residential & commercial properties in {data.name}, Los Gatos</span>
            </div>
            <div class="dcc-actions">
              <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">📞 Call Now: {siteConfig.phoneFormatted}</a>
              <a href="/services/" class="btn btn-secondary btn-lg">Explore All Services</a>
            </div>
            <div class="dcc-features">
              <span>⚡ Same-Day & Emergency Slots Available</span>
              <span>🛡️ California C-10 Licensed #{siteConfig.licenseNumber}</span>
              <span>📍 Locally Based in Los Gatos</span>
            </div>
          </div>
        </div>

        <div class="contact-info-panel">
          <div class="office-card">
            <h3>Los Gatos Headquarters</h3>
            <p class="office-addr">{siteConfig.address.full}</p>
            <p class="office-phone">
              <strong>Phone:</strong> <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneFormatted}</a>
            </p>
            <p class="office-hours">
              <strong>Hours:</strong> {siteConfig.hours}
            </p>
            <p class="office-license">
              <strong>License:</strong> {siteConfig.licenseNumber}
            </p>
          </div>

          <div class="map-wrapper">
            <iframe
              title={`Map of Los Gatos service area for ${data.name}`}
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d50812.3533475878!2d-121.9984927!3d37.2358055!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x808e351ff24976cf%3A0xc3b8a1c863a35ea!2s14165%20Capri%20Dr%2C%20Los%20Gatos%2C%20CA%2095032!5e0!3m2!1sen!2sus!4v1710000000000!5m2!1sen!2sus"
              width="100%"
              height="300"
              style="border:0; border-radius: 10px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .neighborhood-hero {
    position: relative;
    background: linear-gradient(135deg, rgba(11, 19, 43, 0.94) 0%, rgba(15, 23, 42, 0.88) 100%),
                url('/images/los-gatos-ev-charger-installation-repair-hero.jpg') center/cover no-repeat;
    color: #FFFFFF;
    padding: 3.5rem 0 4.5rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .breadcrumb-nav {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .breadcrumb-list a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    color: #10B981;
  }

  .breadcrumb-list li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 163, 255, 0.15);
    color: #10B981;
    border: 1px solid rgba(0, 163, 255, 0.35);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.825rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10B981;
  }

  .neighborhood-hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
