    commonProblemsSolved: [
      { problem: 'Nuisance GFCI Breaker Tripping', solution: 'Converted plug-in station to a hardwired setup, eliminating dual-GFCI monitoring conflicts.' },
      { problem: 'Overheating Garage Wall Outlet', solution: 'Replaced cheap builders-grade outlet with industrial Hubbell 14-50 receptacle and #6 copper.' },
