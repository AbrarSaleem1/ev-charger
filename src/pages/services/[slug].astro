---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import HeroShowcaseImage from '../../components/HeroShowcaseImage.astro';
import ContentImage from '../../components/ContentImage.astro';
import siteConfig from '../../data/site-config.json';
import services from '../../data/services.json';
import neighborhoodsList from '../../data/neighborhoods-list.json';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const canonicalUrl = `${siteConfig.domain}/services/${service.slug}/`;

const relatedServices = services.filter((s) => s.slug !== service.slug);

// Rich details per service
const serviceDetails: Record<string, {
  tagline: string;
  scope: string[];
  causesAndEducation: string[];
  executionProcess: { title: string; desc: string }[];
  toolsAndMethods: string[];
  whenToCall: string[];
  commonProblemsSolved: { problem: string; solution: string }[];
  pricingNotes: string;
  faqs: { q: string; a: string }[];
}> = {
  'tesla-wall-connector-installation-repair': {
    tagline: 'Certified Tesla installation and diagnostic repair for Gen 2, Gen 3, and Universal Wall Connectors throughout Los Gatos.',
    scope: [
      'Dedicated 60-amp double-pole circuit installation for maximum 48A (11.5 kW) charging velocity',
      'Heavy-duty #6 AWG or #4 AWG THHN copper wiring run through rigid steel or EMT conduit',
      'Wi-Fi commissioning, commissioning wizard setup, and firmware synchronization',
      'Dual-unit power sharing setup for multi-Tesla households on a single electrical feed',
      'Diagnostic testing and component repair for red flashing error codes (3, 4, 6 blinks)'
    ],
    causesAndEducation: [
      'Tesla Wall Connectors draw continuous maximum current for hours. If terminal lugs are torqued by hand rather than calibrated torque screwdrivers, microscopic thermal expansion causes terminal looseness and heat buildup.',
      'A flashing red light indicates an active safety interlock. Gen 3 units perform real-time resistance checks between ground, neutral, and line legs. High ground impedance or line voltage dips below 208V trigger protective shutoffs.',
      'Our certified electricians use factory diagnostic tools to communicate directly with the Wall Connector internal web server, inspect fault logs, and restore full-speed charging safely.'
    ],
    executionProcess: [
      { title: 'Load Calculation & Breaker Selection', desc: 'We inspect your main panel and verify capacity for a dedicated 60A breaker under NEC continuous load standards.' },
      { title: 'Conduit & Wire Pull', desc: 'We install commercial EMT or rigid conduit and pull high-temp 90°C copper conductors directly to the mounting location.' },
      { title: 'Digital Precision Torqueing', desc: 'We torque all terminal screws to exactly 4.5 N-m (40 in-lbs) to prevent thermal degradation.' },
      { title: 'Wi-Fi Pairing & Commissioning', desc: 'We connect to the unit broadcast Wi-Fi, set breaker ratings, configure power sharing if needed, and conduct test charges.' }
    ],
    toolsAndMethods: [
      'Digital calibrated torque screwdrivers to ensure factory-spec terminal seating',
      'True-RMS digital clamp multimeters for testing phase-to-phase and phase-to-ground voltages under full load',
      'Thermal imaging infrared cameras to inspect for hot spots along terminal blocks and breaker contacts',
      'Industrial anti-oxidant joint compound applied to all aluminum-to-copper transitions'
    ],
    whenToCall: [
      'Tesla Wall Connector indicator light is blinking red or solid red',
      'Your Tesla vehicle displays "Charging Speed Reduced" or "Check Power Source"',
      'The Wall Connector handle or wall cable feels uncomfortably hot to the touch',
      'You are purchasing a new Tesla Model 3, Model Y, Model S, Model X, or Cybertruck'
    ],
    commonProblemsSolved: [
      { problem: '4 Red Blinks (High Resistance)', solution: 'Re-terminated wire lugs, eliminated line voltage drop, and verified main panel lug torque.' },
      { problem: 'Breaker Tripping After 20 Minutes', solution: 'Replaced standard 50A breaker with continuous-rated 60A commercial breaker and upsized conductors.' },
      { problem: 'Unable to Pair with Home Wi-Fi', solution: 'Configured a dedicated 2.4 GHz IoT Wi-Fi channel and updated internal Tesla firmware.' }
    ],
    pricingNotes: 'Every Tesla Wall Connector installation or diagnostic project receives an itemized technical proposal based on conduit pathway distance, panel capacity, and mounting specifications.',
    faqs: [
      { q: 'Can a Tesla Wall Connector charge non-Tesla electric vehicles?', a: 'Yes! The Tesla Universal Wall Connector features an integrated J1772 magic dock adapter, allowing it to charge any electric car (Rivian, Ford, Porsche, Hyundai) as well as Tesla vehicles.' },
      { q: 'What size breaker is required for full-speed 48-amp charging?', a: 'Under the 80% continuous load rule of the NEC, a 48-amp charger strictly requires a 60-amp circuit breaker and minimum #6 AWG copper wire.' },
      { q: 'Why is my Tesla charging at only 16 or 24 amps instead of 48 amps?', a: 'This occurs when line voltage drops, when the internal temperature sensor throttles current, or when the Wall Connector was commissioned on a lower breaker setting during initial setup.' },
      { q: 'Does Los Gatos require an electrical permit to install a Tesla charger?', a: 'Yes. The Town of Los Gatos requires an electrical building permit. We manage all permit filings and schedule the town inspection for you.' },
      { q: 'Can two Tesla Wall Connectors share a single electrical circuit?', a: 'Yes! Gen 3 Wall Connectors communicate wirelessly to dynamically balance available power between two vehicles without overloading your panel.' }
    ]
  },
  'level-2-charger-installation': {
    tagline: 'Professional 240-volt Level 2 home charging station installations for all electric vehicle makes and models across Los Gatos.',
    scope: [
      'Dedicated 240V circuit design (40A, 50A, or 60A) customized to your vehicle onboard charger',
      'Installation of hardwired stations or commercial-grade NEMA 14-50 receptacles',
      'Compatibility with ChargePoint, Rivian, JuiceBox, Autel, Emporia, Wallbox, and Ford Pro',
      'Interior crawlspace routing, attic runs, or exterior conduit trenching to detached garages',
      'Complete Town of Los Gatos permitting and municipal building inspection coordination'
    ],
    causesAndEducation: [
      'Standard 120V Level 1 trickle chargers take 24 to 40 hours to charge a modern electric SUV. Upgrading to a 240V Level 2 station reduces charging times to 4 to 8 hours.',
      'Hardwiring a Level 2 charger provides the safest connection, delivers up to 48 amps (11.5 kW), and prevents nuisance GFCI breaker trips associated with plug-in receptacles.',
      'Our electricians evaluate your home daily mileage and onboard vehicle charger capacity to specify the perfect amperage and conduit configuration.'
    ],
    executionProcess: [
      { title: 'Electrical Capacity Evaluation', desc: 'We calculate panel capacity and select the optimal circuit rating (40A, 50A, or 60A).' },
      { title: 'Conduit Routing & Wire Pull', desc: 'We install protective steel EMT or schedule 80 PVC conduit and pull continuous copper conductors.' },
      { title: 'Station Mounting & Termination', desc: 'We securely mount the charger to wall framing and torque all electrical terminations.' },
      { title: 'Commissioning & Test Charge', desc: 'We verify line voltage under load, pair mobile apps, and test charging with an EV.' }
    ],
    toolsAndMethods: [
      'Heavy-wall EMT conduit and steel set-screw couplings for physical protection against vehicle bumper impact',
      'Solid copper conductors (THHN/THWN-2) rated for 90°C continuous operation',
      'Digital micro-ohmmeter testing for validating ground bonding resistance',
      'UL-listed commercial double-pole circuit breakers'
    ],
    whenToCall: [
      'You are bringing home a new electric vehicle or plug-in hybrid',
      'Your existing charger takes too long to replenish your daily commuter range',
      'You need an outdoor weatherproof charging pedestal for an uncovered driveway',
      'You want to convert a plug-in charger to a faster hardwired installation'
    ],
    commonProblemsSolved: [
      { problem: 'Nuisance GFCI Breaker Tripping', solution: 'Converted plug-in station to a hardwired setup, eliminating dual-GFCI monitoring conflicts.' },
      { problem: 'Overheating Garage Wall Outlet', solution: 'Replaced cheap builders-grade outlet with industrial Hubbell 14-50 receptacle and #6 copper.' },
      { problem: 'Detached Garage Lacking 240V', solution: 'Trenched 18 inches deep to detached garage, buried schedule 80 PVC, and installed a 100A subpanel.' }
    ],
    pricingNotes: 'Each Level 2 charging station project is custom engineered based on vehicle onboard charging rate, garage conduit routing, and dedicated breaker requirements.',
    faqs: [
      { q: 'Which is better: hardwired or plug-in Level 2 charger?', a: 'Hardwired is superior for home use: it allows faster 48A charging, eliminates loose plug hazards, and avoids nuisance GFCI breaker trips.' },
      { q: 'Will a Level 2 charger work with all electric cars?', a: 'Yes! Universal Level 2 chargers use the industry-standard J1772 or NACS connector, making them compatible with every EV on the road.' },
      { q: 'How long does the installation take?', a: 'Most standard attached garage installations are completed in 3 to 5 hours by our certified electrical crew.' },
      { q: 'Do you handle the Town of Los Gatos permits?', a: 'Yes. We manage the entire permit process from blueprint submission to the final building inspector walkthrough.' },
      { q: 'Can I install a Level 2 charger outdoors?', a: 'Yes. We install NEMA 4 or 4X weatherproof charging stations and pedestals designed for outdoor rain, sun, and fog.' }
    ]
  },
  'ev-charger-circuit-panel-upgrade': {
    tagline: '200A and 400A electrical service heavy-ups, subpanel additions, and smart load management to power high-speed EV charging safely.',
    scope: [
      'Upgrading older 100A or 125A main panels to modern 200A or 225A copper-bus panels',
      'Replacement of hazardous Zinsco, Federal Pacific Electric, and Pushmatic panels',
      'Secondary 100A subpanel installations for detached garages, workshops, and multi-EV setups',
      'Smart energy management load-shedding switches (DCC-9, NeoCharge, Lumin)',
      'Coordination with PG&E for overhead service drop upgrades and underground meter approvals'
    ],
    causesAndEducation: [
      'Homes built in Los Gatos before 1980 often have 100A or 125A electrical panels. Adding a continuous 60A EV charging circuit exceeds panel headroom and triggers main breaker overloads.',
      'Zinsco and Federal Pacific panels have documented design defects where breakers fail to trip and busbars melt under sustained 40A+ continuous loads.',
      'Upgrading to a 200A service modernizes your entire electrical system, providing headroom for EV charging, heat pumps, air conditioning, and solar storage.'
    ],
    executionProcess: [
      { title: 'Load Calculation & PG&E Planning', desc: 'We calculate total household loads and submit service planning documents to PG&E.' },
      { title: 'Town Permitting & Scheduling', desc: 'We obtain municipal electrical permits and schedule the morning meter disconnect with PG&E.' },
      { title: 'Panel Removal & Installation', desc: 'We replace the old panel with a 200A copper bus panel, install dual copper ground rods, and rewire all branch circuits.' },
      { title: 'PG&E Reconnect & Inspection', desc: 'PG&E re-energizes the new service, and we accompany the Town inspector for final permit sign-off.' }
    ],
    toolsAndMethods: [
      'Commercial-grade copper bus panels (Square D QO or Eaton CH) with high interrupting capacity',
      'Dual 8-foot copper grounding electrodes driven into undisturbed earth with continuous #4 AWG ground bonding',
      'Whole-home Type 2 surge protective devices (SPD) to guard sensitive EV electronics',
      'Industrial torque wrenches to ensure exact torque on main service entrance lugs'
    ],
    whenToCall: [
      'Your main breaker trips when the EV charger runs at the same time as your air conditioner or dryer',
      'Your home has an older 100A or 125A panel with no empty breaker slots',
      'Your panel is a known fire hazard brand (Zinsco, Sylvania, Federal Pacific, Pushmatic)',
      'You are planning to add a second electric vehicle, an ADU, or a heat pump'
    ],
    commonProblemsSolved: [
      { problem: 'Zinsco Panel Melting Under EV Load', solution: 'Replaced hazardous panel with 200A Square D QO panel, new meter-main, and whole-home surge protection.' },
      { problem: 'Insufficient Breaker Space for EV Circuit', solution: 'Installed a 100A garage subpanel to house the new EV charging breaker and future workshop circuits.' },
      { problem: 'Utility Service Upgrade Too Costly', solution: 'Installed a code-approved DCC-9 smart load-shedder that pauses EV charging during peak household draw.' }
    ],
    pricingNotes: 'All panel upgrades and subpanel installations include comprehensive NEC Article 220 load calculations, PG&E service coordination, and Town of Los Gatos permits.',
    faqs: [
      { q: 'How long will my power be off during a panel upgrade?', a: 'Power is typically off for only 4 to 6 hours while our electricians swap the panel equipment. We coordinate with PG&E so power is restored before the end of the day.' },
      { q: 'What is a smart energy management switch (DCC-9)?', a: 'A DCC-9 monitors your main panel in real time. If total household power approaches panel limits, it automatically pauses your EV charger, restoring power once other appliances shut off.' },
      { q: 'Why are Zinsco panels dangerous for EV charging?', a: 'Zinsco breakers often fail to trip during overcurrent, and their aluminum busbars oxidize and melt under sustained 40A+ continuous charging loads.' },
      { q: 'Does a panel upgrade include whole-home surge protection?', a: 'Yes! All of our panel upgrades include a heavy-duty Type 2 surge protective device to protect your EV onboard computer and home electronics.' },
      { q: 'Do you handle the PG&E paperwork?', a: 'Yes. We manage all service applications, engineering clearances, and meter disconnect/reconnect scheduling directly with PG&E.' }
    ]
  },
  'ev-charger-troubleshooting-repair': {
    tagline: 'Same-day diagnostic dispatch and emergency electrical repairs for failing EV chargers, tripped breakers, and melted outlets in Los Gatos.',
    scope: [
      'Comprehensive on-site troubleshooting for all Level 2 and Tesla charging stations',
      'Diagnosis and replacement of overheating, buzzing, or tripping circuit breakers',
      'Replacement of melted, scorched, or loose NEMA 14-50 receptacles and plugs',
      'Resolution of ground-fault interrupter (GFCI) errors and high-resistance wiring faults',
      'Testing vehicle inlet communication, pilot wire signals, and onboard charger handshakes'
    ],
    causesAndEducation: [
      'EV chargers draw high continuous current for hours. Slight imperfections—such as loose wire lugs, undersized copper gauge, or poor grounding—lead to thermal runaway and component failure.',
      'Repeated breaker trips usually indicate that the breaker is suffering from thermal fatigue, operating in an unventilated hot garage, or that the circuit wire gauge was undersized.',
      'Our mobile diagnostic vans carry calibrated instruments, replacement breakers, industrial receptacles, and factory diagnostic tools to fix problems in a single visit.'
    ],
    executionProcess: [
      { title: 'Visual & Thermal Safety Scan', desc: 'We inspect for scorched insulation, melted plastic, and use infrared cameras to detect hidden hot spots.' },
      { title: 'Electrical Metering & Testing', desc: 'We test phase-to-phase voltage, neutral stability, ground resistance, and pilot signal frequencies.' },
      { title: 'Component Replacement & Re-Torque', desc: 'We replace damaged breakers or receptacles and re-torque all connections to exact manufacturer specs.' },
      { title: 'Full-Load Test & Verification', desc: 'We run a test charge at maximum amperage while monitoring thermal levels to verify permanent repair.' }
    ],
    toolsAndMethods: [
      'FLIR infrared thermal imaging cameras to pinpoint resistance hot spots before fires occur',
      'Digital ground resistance testers to verify low-impedance earthing systems',
      'EVSE test simulators to verify pilot signal wave frequencies and ground-fault trip thresholds',
      'Commercial replacement breakers and Hubbell industrial brass receptacles stocked on every van'
    ],
    whenToCall: [
      'Your charging station displays a red error light, fault code, or refuses to power on',
      'The circuit breaker trips immediately or within 15 to 30 minutes of plugging in your EV',
      'You notice a burning electrical smell, humming noise, or scorched plastic near the charger',
      'Your vehicle shows an error message like "Charging Stopped" or "Charge Port Latch Failed"'
    ],
    commonProblemsSolved: [
      { problem: 'Melted Leviton 14-50 Receptacle', solution: 'Replaced scorched outlet with commercial-grade Hubbell receptacle and re-terminated copper conductors.' },
      { problem: 'Intermittent Ground-Fault Trips', solution: 'Traced ground fault to loose earth bond at the main water line, re-bonded and stabilized ground reference.' },
      { problem: 'Tesla Wall Connector 6 Red Blinks', solution: 'Identified thermal shutoff from loose wire lugs, re-torqued terminals with calibrated digital wrench.' }
    ],
    pricingNotes: 'Our troubleshooting calls provide systematic thermal scanning, phase voltage verification, ground impedance testing, and immediate component restoration.',
    faqs: [
      { q: 'How fast can an electrician arrive for an emergency EV charger repair in Los Gatos?', a: 'Our mobile dispatch facility is located at 14165 Capri Drive in Los Gatos. We offer same-day priority service with typical arrival times of 30 to 60 minutes.' },
      { q: 'Can I reset a tripped EV charger breaker myself?', a: 'You can reset it once. However, if it trips again immediately or within 30 minutes, do not continue resetting it. Continuous tripping indicates high heat, a short circuit, or wire degradation that requires professional inspection.' },
      { q: 'Why did my 240V garage outlet melt?', a: 'Many builders install cheap residential-grade outlets designed for clothes dryers that run for only 45 minutes. An EV pulls continuous high power for 8 hours, causing thermal fatigue and melting the contacts.' },
      { q: 'Do you carry replacement parts on your service vans?', a: 'Yes! Our vans are stocked with commercial double-pole breakers, industrial receptacles, heavy-gauge wire, and diagnostic test simulators to resolve most issues in one visit.' },
      { q: 'Do you provide warranties on electrical repairs?', a: 'Yes. All of our repair work is backed by a 1-year parts and craftsmanship warranty.' }
    ]
  },
  'commercial-multi-unit-ev-charging': {
    tagline: 'Turnkey commercial, workplace, and multi-unit residential (MUD/HOA) EV charging stations across Los Gatos and Silicon Valley.',
    scope: [
      'Dual-port commercial Level 2 pedestal charging stations with cable management retractors',
      'Multi-family apartment and condominium carport electrical infrastructure',
      'California Civil Code Section 4781 (Davis-Stirling) HOA compliance and approval engineering',
      'Smart sub-metering, RFID badge access, and automated credit card payment processing',
      'CalGreen Title 24 compliance and electrical load management for commercial properties'
    ],
    causesAndEducation: [
      'Bay Area employees and tenants actively demand EV charging at work and home. Adding commercial stations increases property value, attracts high-value tenants, and satisfies CalGreen building mandates.',
      'Installing multi-vehicle charging without dynamic load management can trigger massive commercial utility demand charges. Smart networked stations balance electrical loads across vehicles automatically.',
      'Our commercial electrical team handles utility transformer coordination, concrete pedestal trenching, ADA accessibility compliance, and municipal approvals from start to finish.'
    ],
    executionProcess: [
      { title: 'Commercial Facility Site Survey', desc: 'We evaluate electrical switchgear, available spare capacity, and optimal parking stall locations.' },
      { title: 'Civil & Electrical Engineering', desc: 'We design single-line electrical diagrams, ADA access paths, and underground conduit trenching plans.' },
      { title: 'Town Permitting & Trenching', desc: 'We secure commercial permits through Town of Los Gatos and execute precision asphalt cutting and trenching.' },
      { title: 'Pedestal Installation & Networking', desc: 'We pour concrete footings, mount commercial pedestals, pull conductors, and configure cellular billing networks.' }
    ],
    toolsAndMethods: [
      'Commercial pavement cutting, directional boring, and schedule 80 PVC conduit infrastructure',
      'Heavy-duty commercial pedestals with stainless steel hardware and spring-loaded cable management',
      'Cellular gateway integration for cloud-based software management and payment remittance',
      'Digital sub-metering compliant with California Division of Measurement Standards (DMS)'
    ],
    whenToCall: [
      'You are an HOA board member or property manager receiving resident requests for carport charging',
      'Your commercial office building or retail center wants to offer destination charging to customers',
      'You are remodeling a multi-family property subject to California CalGreen EV mandatory requirements',
      'You need revenue-grade sub-metering to track electricity usage in shared parking structures'
    ],
    commonProblemsSolved: [
      { problem: 'HOA Board Disagreements Over Power Costs', solution: 'Installed smart networked chargers with automated resident RFID billing and direct utility reimbursement.' },
      { problem: 'Limited Commercial Electrical Capacity', solution: 'Deployed dynamic smart load-balancing that shares 80A of capacity across 4 charging stalls simultaneously.' },
      { problem: 'Carports Separated by Concrete Lots', solution: 'Conducted directional underground boring to run electrical conduit beneath parking pavement without repaving.' }
    ],
    pricingNotes: 'Commercial and multi-unit charging station projects are quoted with comprehensive turn-key engineering proposals based on stall count, trenching distances, and electrical switchgear capacity.',
    faqs: [
      { q: 'What are the CalGreen requirements for EV charging in Los Gatos commercial buildings?', a: 'California CalGreen code mandates that a designated percentage of commercial and multi-family parking spaces must be EV-Capable, EV-Ready, or have active EVSE charging stations installed.' },
      { q: 'How do HOAs ensure non-EV owners do not pay for charging electricity?', a: 'We install California DMS-certified digital sub-meters or smart cellular chargers that bill the EV owner directly per kilowatt-hour, reimbursing the HOA monthly.' },
      { q: 'Can commercial EV chargers generate revenue for property owners?', a: 'Yes! Networked stations allow property owners to set public charging rates by time or kilowatt-hour, generating revenue while providing an essential community amenity.' },
      { q: 'Do you assist with commercial EV incentive programs in California?', a: 'Yes. We assist commercial clients in identifying and applying for regional air quality grants, PG&E EV fleet incentives, and federal commercial tax credits.' },
      { q: 'Are commercial pedestal chargers ADA compliant?', a: 'Yes. Our engineering designs include accessible path-of-travel routes, compliant operable parts height (between 15 and 48 inches), and designated clear floor spaces.' }
    ]
  }
};

const details = serviceDetails[service.slug] || {
  tagline: service.shortDescription,
  scope: ['Comprehensive diagnostic testing', 'Code-compliant installation', 'Full town permitting'],
  causesAndEducation: ['Professional electrical engineering ensures long-term safety and performance.'],
  executionProcess: [{ title: 'Site Inspection', desc: 'We evaluate electrical capacity and plan the installation.' }],
  toolsAndMethods: ['Commercial-grade copper conductors and calibrated digital instruments.'],
  whenToCall: ['You need professional electrical service in Los Gatos.'],
  commonProblemsSolved: [{ problem: 'Electrical failure', solution: 'Diagnosed and restored to full code compliance.' }],
  pricingNotes: 'Detailed written proposals provided before work begins.',
  faqs: [
    { q: 'Do you service all of Los Gatos?', a: 'Yes, our licensed electricians cover all 25 Los Gatos neighborhoods.' },
    { q: 'Are you licensed and insured?', a: 'Yes, California C-10 Electrical Contractor License #1048291.' }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "serviceType": service.name,
  "provider": {
    "@type": "Electrician",
    "name": siteConfig.businessName,
    "telephone": siteConfig.phone,
    "url": siteConfig.domain,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": siteConfig.address.street,
      "addressLocality": siteConfig.address.city,
      "addressRegion": siteConfig.address.state,
      "postalCode": siteConfig.address.zip,
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Los Gatos",
    "sameAs": "https://en.wikipedia.org/wiki/Los_Gatos,_California"
  },
  "description": service.shortDescription
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.domain
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": `${siteConfig.domain}/services/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.shortName,
      "item": canonicalUrl
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": details.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

const serviceImages: Record<string, { src: string; alt: string; title: string; caption: string; badge: string }> = {
  'tesla-wall-connector-installation-repair': {
    src: '/images/tesla-wall-connector-repair-diagnostics.jpg',
    alt: 'Certified Electrician Testing Tesla Wall Connector with Fluke Multimeter in Los Gatos',
    title: 'Tesla Wall Connector Diagnostics & Repair in Los Gatos, CA',
    caption: 'Our licensed electricians verify line voltage, high-temperature copper terminal torque, and communication handshakes on Tesla Wall Connectors.',
    badge: 'Tesla Diagnostic Service • Los Gatos, CA'
  },
  'level-2-charger-installation': {
    src: '/images/level-2-home-ev-charger-installation.jpg',
    alt: 'Level 2 240V Home EV Charger Installation with Steel EMT Conduit in Los Gatos Garage',
    title: 'Level 2 EV Charger Installation in Los Gatos, CA',
    caption: 'Turnkey 240-volt Level 2 charging stations wired with heavy-duty EMT conduit and dedicated circuit protection.',
    badge: '240V Level 2 Install • Los Gatos, CA'
  },
  'ev-charger-circuit-panel-upgrade': {
    src: '/images/ev-electrical-panel-upgrade-200-amp.jpg',
    alt: 'Licensed Electrician Installing 60A Breaker in 200A Service Electrical Panel in Los Gatos',
    title: '200A Electrical Panel Upgrade for EV Charging in Los Gatos, CA',
    caption: 'Full 200-amp service panel heavy-ups providing dedicated electrical headroom for high-draw EV charging stations.',
    badge: '200A Panel Upgrade • Los Gatos, CA'
  },
  'ev-charger-troubleshooting-repair': {
    src: '/images/ev-troubleshooting-thermal-imaging.jpg',
    alt: 'FLIR Infrared Thermal Scan of EV Charger Circuit Breaker and 240V NEMA 14-50 Receptacle',
    title: 'EV Charger Troubleshooting & Thermal Diagnostic Scan in Los Gatos, CA',
    caption: 'Infrared thermal cameras and digital test simulators isolate resistive hotspots, ground faults, and nuisance breaker tripping.',
    badge: 'Thermal Diagnostics • Los Gatos, CA'
  },
  'commercial-multi-unit-ev-charging': {
    src: '/images/commercial-multi-unit-ev-charging-stations.jpg',
    alt: 'Commercial Level 2 Dual-Port EV Charging Pedestals in Los Gatos Office Parking Lot',
    title: 'Commercial & Multi-Unit EV Charging Stations in Los Gatos, CA',
    caption: 'Turnkey commercial charging pedestals with cable management, RFID access control, and dynamic electrical load management.',
    badge: 'Commercial EV Systems • Los Gatos, CA'
  }
};

const serviceImage = serviceImages[service.slug] || serviceImages['level-2-charger-installation'];

const serviceDetailImageSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "contentUrl": `${siteConfig.domain}${serviceImage.src}`,
  "url": `${siteConfig.domain}${serviceImage.src}`,
  "name": serviceImage.title,
  "description": serviceImage.alt,
  "caption": serviceImage.caption,
  "width": 1280,
  "height": 720
};
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema, serviceDetailImageSchema]}
>
  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Services</a></li>
          <li aria-current="page">{service.shortName}</li>
        </ol>
      </nav>

      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Available Throughout Los Gatos & All 25 Neighborhoods</span>
          </div>
          <h1>{service.name} in Los Gatos, CA</h1>
          <p class="hero-sublead">{details.tagline}</p>
          <p class="hero-desc">{service.shortDescription}</p>

