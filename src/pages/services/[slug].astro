const details = serviceDetails[service.slug] || {
  tagline: service.shortDescription,
  scope: ['Comprehensive diagnostic testing', 'Code-compliant component repair', 'Full safety verification'],
  causesAndEducation: ['Professional electrical engineering ensures long-term safety and performance.'],
  executionProcess: [{ title: 'Site Diagnostic', desc: 'We evaluate electrical faults and test components.' }],
  toolsAndMethods: ['Commercial-grade copper conductors and calibrated digital instruments.'],
  whenToCall: ['You need professional EV charger repair in Los Gatos.'],
  commonProblemsSolved: [{ problem: 'Electrical failure', solution: 'Diagnosed and restored to full code compliance.' }],
  pricingNotes: 'Detailed written proposals provided before work begins.',
  faqs: [
    { q: 'Do you service all of Los Gatos?', a: 'Yes, our licensed electricians cover all 25 Los Gatos neighborhoods.' },
    { q: 'Are you licensed and insured?', a: 'Yes, California C-10 Electrical Contractor License #1048291.' }
