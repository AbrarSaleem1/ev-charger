---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import HeroShowcaseImage from '../../components/HeroShowcaseImage.astro';
import ContentImage from '../../components/ContentImage.astro';
import siteConfig from '../../data/site-config.json';
import services from '../../data/services.json';
import neighborhoodsList from '../../data/neighborhoods-list.json';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const canonicalUrl = `${siteConfig.domain}/services/${service.slug}/`;

const relatedServices = services.filter((s) => s.slug !== service.slug);

// Rich details per service
const serviceDetails: Record<string, {
  tagline: string;
  scope: string[];
  causesAndEducation: string[];
  executionProcess: { title: string; desc: string }[];
  toolsAndMethods: string[];
  whenToCall: string[];
  commonProblemsSolved: { problem: string; solution: string }[];
  pricingNotes: string;
  faqs: { q: string; a: string }[];
}> = {
  'tesla-wall-connector-installation-repair': {
    tagline: 'Certified Tesla diagnostic troubleshooting and component repair for Gen 2, Gen 3, and Universal Wall Connectors throughout Los Gatos.',
    scope: [
      'Diagnostic testing and fault clearing for red blinking error codes (1, 2, 3, 4, 5, 6 blinks)',
      'Thermal power-throttling investigation and high-resistance wire terminal re-torqueing',
      'Wi-Fi commissioning troubleshooting, commissioning wizard recovery, and firmware synchronization',
      'Diagnostic repair and replacement of loose, overheated, or scorched terminal lug blocks',
      'Dual-unit power sharing diagnostic re-balancing and wireless handshake verification'
    ],
    causesAndEducation: [
      'Tesla Wall Connectors draw continuous maximum current for hours. If terminal lugs are torqued by hand rather than calibrated digital torque screwdrivers, microscopic thermal expansion causes terminal looseness, electrical resistance, and severe heat buildup.',
      'A flashing red light indicates an active safety interlock. Gen 3 units perform real-time resistance checks between ground, neutral, and line legs. High ground impedance, loose neutral bonds, or line voltage dips below 208V trigger protective shutoffs.',
      'Our certified electricians use factory diagnostic tools to communicate directly with the Wall Connector internal web server, inspect fault logs, and restore full-speed 48A charging safely.'
    ],
    executionProcess: [
      { title: 'Thermal Safety Scan & Internal Log Inspection', desc: 'We inspect the charging unit for scorch marks and access the internal diagnostic web server to read precise fault codes.' },
      { title: 'True-RMS Voltage & Ground Impedance Metering', desc: 'We measure line-to-line voltage under active load, verify grounding electrode resistance, and inspect breaker connections.' },
      { title: 'Digital Precision Re-Torqueing & Lug Restoration', desc: 'We clean terminal blocks, replace damaged lugs, and torque all screws to exactly 4.5 N-m (40 in-lbs) with digital tools.' },
      { title: 'Full 48A Continuous Load Test', desc: 'We run an active test charge at maximum amperage while monitoring thermal levels with infrared imaging to verify permanent repair.' }
    ],
    toolsAndMethods: [
      'Digital calibrated torque screwdrivers to ensure factory-spec terminal seating',
      'True-RMS digital clamp multimeters for testing phase-to-phase and phase-to-ground voltages under full load',
      'Thermal imaging infrared cameras to inspect for hot spots along terminal blocks and breaker contacts',
      'Industrial anti-oxidant joint compound applied to all aluminum-to-copper transitions'
    ],
    whenToCall: [
      'Tesla Wall Connector indicator light is blinking red or solid red',
      'Your Tesla vehicle displays "Charging Speed Reduced" or "Check Power Source"',
      'The Wall Connector handle or wall cable feels uncomfortably hot to the touch',
      'The dedicated 60A circuit breaker trips repeatedly during charging'
    ],
    commonProblemsSolved: [
      { problem: '4 Red Blinks (High Resistance)', solution: 'Re-terminated wire lugs, eliminated line voltage drop, and verified main panel lug torque.' },
      { problem: 'Breaker Tripping After 20 Minutes', solution: 'Replaced standard 50A breaker with continuous-rated 60A commercial breaker and upsized conductors.' },
      { problem: 'Unable to Pair with Home Wi-Fi', solution: 'Configured a dedicated 2.4 GHz IoT Wi-Fi channel and updated internal Tesla firmware.' }
    ],
    pricingNotes: 'Every Tesla Wall Connector diagnostic and repair project receives an itemized technical proposal detailing testing procedures, replacement parts, and warranty coverage.',
    faqs: [
