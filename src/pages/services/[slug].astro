      { title: 'Overcurrent Device & Busbar Diagnostic', desc: 'We test individual breaker trip thresholds, measure contact resistance, and inspect busbar plating for pitting or corrosion.' },
      { title: 'Breaker Replacement & Terminal Re-Torque', desc: 'We install commercial continuous-duty double-pole breakers and torque all lugs to exact manufacturer inch-pound specifications.' },
      { title: 'Full-Load Verification & Phase Balancing', desc: 'We energize the EV charger alongside major household appliances to verify that operating temperatures and phase currents remain well within safe limits.' }
    ],
    toolsAndMethods: [
      'Commercial-grade copper bus panels (Square D QO or Eaton CH) with high interrupting capacity',
