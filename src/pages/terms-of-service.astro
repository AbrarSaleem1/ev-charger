---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContentImage from '../components/ContentImage.astro';
import siteConfig from '../data/site-config.json';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms of Service' }
];
---

<BaseLayout
  title={`Terms of Service | ${siteConfig.businessName}`}
  description={`Terms and conditions governing the use of ${siteConfig.businessName} and our EV electrical dispatch services.`}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="Terms of Service"
    subtitle="Please review these terms and conditions prior to using our website and dispatch services."
    breadcrumbs={breadcrumbs}
    variant="short"
  />

  <section class="section">
    <div class="container container-narrow content-body">
      <p>Last Updated: March 2026</p>

      <h2>1. Acceptance of Terms</h2>
      <p>
        By accessing or using {siteConfig.domain} and our emergency telephone hotline ({siteConfig.phoneFormatted}), you agree to be bound by these Terms of Service and all applicable federal, state, and local laws.
      </p>

      <h2>2. Nature of Services</h2>
      <p>
        {siteConfig.businessName} provides licensed electrical contracting services specializing in electric vehicle charging station troubleshooting, diagnostics, circuit breaker fixes, and component repairs. All electrical work, physical repairs, permitting, and equipment warranties are performed in accordance with California Title 24, the National Electrical Code, and Town of Los Gatos building codes.
      </p>

      <h2>3. Service Proposals & Scope of Work</h2>
      <p>
        All electrical diagnostic and repair projects require written homeowner approval prior to the commencement of work. Project scope is determined after reviewing property wiring or conducting an on-site physical evaluation by a licensed C-10 journeyman or master electrician.
      </p>

      <h2>4. Limitation of Liability</h2>
      <p>
        {siteConfig.businessName} maintains comprehensive commercial general liability insurance and state licensing. We shall not be liable for preexisting electrical wiring defects, unpermitted prior modifications, or utility power grid interruptions beyond our direct control.
      </p>

      <h2>5. Governing Law</h2>
      <p>
        These Terms are governed by and construed in accordance with the laws of the State of California, without regard to conflict of law principles.
      </p>

      <div style="margin-top: 2.5rem;">
        <ContentImage
          src="/images/los-gatos-electrician-service-van.jpg"
          alt="Los Gatos EV Charger Pros service van and certified technician"
          title="Los Gatos EV Charger Pros Electricians"
          caption="All diagnostic and repair operations adhere to California C-10 Electrical Contracting standards and local Town of Los Gatos safety codes."
          badge="California C-10 Licensed • #1048291"
        />
      </div>
    </div>
  </section>
</BaseLayout>
