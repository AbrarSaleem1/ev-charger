---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ContentImage from '../components/ContentImage.astro';
import siteConfig from '../data/site-config.json';
import services from '../data/services.json';
import neighborhoodsList from '../data/neighborhoods-list.json';

const pageTitle = "EV Charger Repair & Troubleshooting Los Gatos | 24/7 Electricians";
const pageDescription = "Los Gatos EV Charger Repair & Diagnostics — 24/7 Licensed Electricians, Fast Response. We repair Tesla Wall Connectors, fix tripped breakers, melted 240V outlets, and failing charging stations across all 25 Los Gatos neighborhoods.";
const canonicalUrl = siteConfig.domain;

const commonProblems = [
  {
    title: "Charger Not Charging or No Power",
    desc: "Vehicle inlet handshake errors, blown branch circuit fuses, tripped GFCI sensors, or dead power supplies diagnosed and repaired rapidly.",
    icon: "🔌"
  },
  {
    title: "Tripping Circuit Breaker",
    desc: "Overheating double-pole breakers, undersized wire gauge, or panel overloads resolved with dedicated continuous-duty 50A/60A breakers.",
    icon: "⚡"
  },
  {
    title: "Flashing Red Error Codes",
    desc: "Tesla Wall Connector 3-red, 4-red, or 6-red blink codes, ChargePoint fault lights, and ground-fault errors isolated with digital oscilloscopes.",
    icon: "⚠️"
  },
  {
    title: "Melted NEMA 14-50 240V Receptacle",
    desc: "Builders-grade outlets degraded by continuous high-amperage heat replaced with industrial-grade Hubbell brass contact receptacles.",
    icon: "🔥"
  },
  {
    title: "Panel Overload / Dropping Power",
    desc: "100A or 125A panels lacking headroom upgraded to 200A or paired with smart DCC-9 load shedding switches.",
    icon: "📊"
  },
  {
    title: "Damaged Cable or Vehicle Connector",
    desc: "Cracked NACS or J1772 handle latches, severed charging cables, and corroded pins replaced with OEM certified components.",
    icon: "🛠️"
  }
];

const faqs = [
  {
    q: "How quickly can an electrician arrive in Los Gatos for an EV charger repair?",
    a: "Our dispatch headquarters is located directly at 14165 Capri Drive in Los Gatos. We offer same-day priority service across all Los Gatos neighborhoods, with typical technician arrival times within 30 to 60 minutes for urgent diagnostic calls."
  },
  {
    q: "Can an EV charger be repaired if my electrical panel trips continuously while charging?",
    a: "Yes. Continuous breaker tripping usually stems from thermal fatigue in older breakers, loose terminal connections creating resistance, undersized wire gauge, or overall panel overload. Our technicians isolate the root cause with thermal imaging and load testing to restore safe, uninterrupted charging."
  },
  {
    q: "Why is my Tesla Wall Connector flashing red?",
    a: "Red LED flashes indicate specific diagnostic fault codes. For example, 1 red blink indicates a ground fault; 2 blinks indicate ground assurance missing; 4 blinks indicate high resistance or voltage drop; and 6 blinks indicate thermal throttling or overheating. Our technicians carry factory diagnostic tools to isolate and repair these faults."
  },
  {
    q: "Does the Town of Los Gatos require building permits for EV charger repairs?",
    a: "Direct like-for-like repairs—such as replacing a melted NEMA 14-50 outlet, swapping a damaged circuit breaker, or replacing defective charging cables—generally do not require new permits. If extensive wiring re-pulls or a main electrical panel heavy-up is necessary, we handle all Town of Los Gatos permitting and inspection coordination."
  },
  {
    q: "Why did my 240V NEMA 14-50 outlet melt or show scorch marks?",
    a: "Residential-grade builder outlets are not engineered for continuous high-amperage heat (32A–40A for 6–10 hours). Under continuous load, loose terminal screws or thin contact prongs cause severe resistance heating. We replace degraded outlets with industrial-duty commercial receptacles (such as Hubbell or Bryant) torqued to exact inch-pound specifications."
  }
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "name": siteConfig.businessName,
  "telephone": siteConfig.phone,
  "url": siteConfig.domain,
  "image": `${siteConfig.domain}/images/los-gatos-ev-charger-installation-repair-hero.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.state,
    "postalCode": siteConfig.address.zip,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "PostalCode", "postalCode": "95030", "addressLocality": "Los Gatos, CA" },
    { "@type": "PostalCode", "postalCode": "95031", "addressLocality": "Los Gatos, CA" },
    { "@type": "PostalCode", "postalCode": "95032", "addressLocality": "Los Gatos, CA" },
    { "@type": "PostalCode", "postalCode": "95033", "addressLocality": "Los Gatos, CA" }
  ],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.geo.latitude,
    "longitude": siteConfig.geo.longitude
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "priceRange": "$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "52"
  }
};

const heroImageSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "contentUrl": `${siteConfig.domain}/images/los-gatos-ev-charger-installation-repair-hero.jpg`,
  "url": `${siteConfig.domain}/images/los-gatos-ev-charger-installation-repair-hero.jpg`,
  "name": "Tesla Wall Connector & Level 2 EV Charger Repair in Los Gatos, California",
  "description": "Licensed residential EV charger repair, Tesla Wall Connector diagnostics, and 240V circuit troubleshooting in Los Gatos, CA home garage.",
  "caption": "Professional EV Charger Repair in Los Gatos Home Garage",
  "representativeOfPage": true,
  "width": 1280,
  "height": 720
};

const diagnosticImageSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "contentUrl": `${siteConfig.domain}/images/tesla-wall-connector-repair-diagnostics.jpg`,
  "url": `${siteConfig.domain}/images/tesla-wall-connector-repair-diagnostics.jpg`,
  "name": "Tesla Wall Connector Diagnostics & EV Charger Repair in Los Gatos, California",
  "description": "Licensed electrician performing voltage and component diagnostics on a Tesla Wall Connector in Los Gatos, CA.",
  "caption": "Professional EV Charger Diagnostics & Repair in Los Gatos, CA",
  "width": 1280,
  "height": 720
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={[homeSchema, faqSchema, heroImageSchema, diagnosticImageSchema]}
>
  <!-- Hero Section -->
  <section class="home-hero">
    <div class="container hero-container-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Licensed C-10 Electrical Contractors • Los Gatos, CA</span>
        </div>
        <h1>Los Gatos EV Charger Repair & Diagnostics — Licensed Electricians, Fast Response</h1>
        <p class="hero-sublead">
          Emergency troubleshooting and permanent diagnostic repairs for Tesla Wall Connectors, Level 2 (240V) systems, tripping breakers, melted 240V outlets, and panel overload issues across all 25 Los Gatos neighborhoods.
        </p>

        <div class="hero-features-strip">
          <div class="hero-feat-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Same-Day Diagnostic Dispatch</span>
          </div>
          <div class="hero-feat-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Error Code & Tripped Breaker Fixes</span>
          </div>
          <div class="hero-feat-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>1-Year Warranty on Repairs</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#contact-form" class="btn btn-lime-teal btn-lg">
            Request Repair
          </a>
          <a href={`tel:${siteConfig.phone}`} class="btn btn-outline-white btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {siteConfig.phoneFormatted}
          </a>
        </div>
      </div>

      <!-- SEO-Optimized Hero Visual Showcase -->
      <div class="hero-visual-card">
        <div class="hero-img-frame">
          <img
            src="/images/los-gatos-ev-charger-installation-repair-hero.jpg"
            alt="Licensed EV Charger Repair and Tesla Wall Connector Diagnostics in Los Gatos, California residential home garage"
            title="Tesla Wall Connector and Level 2 EV Charger Repair in Los Gatos, CA"
            width="1280"
            height="720"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="hero-showcase-img"
          />
          <div class="hero-img-badge">
            <span class="badge-pulse"></span>
            <span>24/7 EV Charger Diagnostics & Repair • Los Gatos, CA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- Services Section -->
  <section class="section services-home-section" id="services">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Our Core Capabilities</span>
        <h2>Comprehensive EV Charger Repair Services in Los Gatos</h2>
        <p class="section-subtitle">
          From Tesla Wall Connectors to tripping breakers and melted 240V receptacles, our licensed electricians handle every aspect of your electric vehicle power diagnostics and repairs.
        </p>
      </div>

      <div class="services-grid">
        {services.map((service) => (
          <article class="service-card">
            <div class="service-icon">⚡</div>
            <h3 class="service-title">
              <a href={`/services/${service.slug}/`} title={`${service.name} in Los Gatos, CA`}>
                {service.name} Los Gatos
              </a>
            </h3>
            <p class="service-desc">{service.shortDescription}</p>
            <a href={`/services/${service.slug}/`} class="service-link" aria-label={`Explore ${service.name} in Los Gatos`}>
              <span>{service.shortName} Los Gatos Guide</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>
        ))}
      </div>

      <!-- In-Content Diagnostic Showcase Image -->
      <ContentImage
        src="/images/tesla-wall-connector-repair-diagnostics.jpg"
        alt="Licensed Los Gatos Electrician Diagnosing Tesla Wall Connector and Level 2 Home EV Charger"
        title="Professional EV Charger Diagnostics & Repair in Los Gatos, CA"
        caption="Our California C-10 certified electricians perform real-time voltage, impedance, and thermal diagnostics on residential Tesla Wall Connectors and Level 2 charging stations throughout Los Gatos."
        badge="Master Diagnostic Inspection • Los Gatos, CA"
      />

      <!-- City Targeted Services Keywords Hub -->
      <div class="city-keywords-hub mt-5">
        <h4 class="hub-title">Targeted EV Repair & Diagnostic Services in Los Gatos, California:</h4>
        <div class="keywords-pills">
          <a href="/services/ev-charger-troubleshooting-repair/" class="keyword-pill">EV Charger Repair Los Gatos</a>
          <a href="/services/tesla-wall-connector-installation-repair/" class="keyword-pill">Tesla Wall Connector Repair Los Gatos</a>
          <a href="/services/level-2-charger-installation/" class="keyword-pill">Level 2 EV Charger Diagnostics Los Gatos</a>
          <a href="/services/ev-charger-circuit-panel-upgrade/" class="keyword-pill">EV Breaker Tripping Repair Los Gatos</a>
          <a href="/services/ev-charger-circuit-panel-upgrade/" class="keyword-pill">240V Dedicated Circuit Repair Los Gatos</a>
          <a href="/services/ev-charger-circuit-panel-upgrade/" class="keyword-pill">EV Electrical Panel Repair Los Gatos</a>
          <a href="/services/ev-charger-troubleshooting-repair/" class="keyword-pill">EV Charger Troubleshooting Los Gatos</a>
          <a href="/services/commercial-multi-unit-ev-charging/" class="keyword-pill">Commercial EV Charger Repair Los Gatos</a>
        </div>
      </div>

      <div class="text-center mt-5">
        <a href="/services/" class="btn btn-primary">
          Explore All EV Repair Services & Technical Details →
        </a>
      </div>
    </div>
  </section>

  <!-- Neighborhoods We Serve Section -->
  <section class="section bg-light" id="neighborhoods">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Local Coverage</span>
        <h2>All 25 Los Gatos Neighborhoods & Service Areas</h2>
        <p class="section-subtitle">
          Select your local neighborhood below to explore housing profiles, specific electrical diagnostic protocols, and dedicated local repair solutions.
        </p>
      </div>

      <div class="neighborhoods-grid">
        {neighborhoodsList.map((n) => (
          <a href={`/locations/${n.slug}/`} class="n-card">
            <span class="n-name">{n.name}</span>
            <span class="n-zip">ZIP {n.zip}</span>
          </a>
        ))}
      </div>

      <div class="text-center mt-5">
        <a href="/locations/" class="btn btn-outline">
          View Complete Los Gatos Locations Hub (All 25 Areas) →
        </a>
      </div>
    </div>
  </section>

  <!-- About Summary -->
  <section class="section about-home-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <span class="section-badge">About Los Gatos EV Charger Repair</span>
          <h2>Local Master Electricians Dedicated Exclusively to EV Charger Diagnostics & Repair</h2>
          <p>
            Established in 2017 in Los Gatos, California, Los Gatos EV Charger Repair was founded on a simple principle: delivering precision, high-amperage electrical diagnostics and restorative repairs designed specifically for modern electric vehicle charging systems. When a home charger fails, overheats, or trips your main panel, we provide rapid, expert diagnosis and lasting resolution.
          </p>
          <p>
            Operating under California C-10 Electrical Contractor License #1048291, our master and journeyman electricians have repaired hundreds of residential Tesla Wall Connectors, resolved historic panel overloads in Almond Grove, and fixed complex commercial and multi-family charging stations across Los Gatos. We operate directly from 14165 Capri Drive, ensuring same-day dispatch, upfront flat-rate pricing, and 100% code-compliant repairs.
          </p>
          <a href="/about-us/" class="btn btn-outline">Learn More About Our Team →</a>
        </div>
        <div class="about-highlights">
          <div class="highlight-item">
            <span class="hl-num">C-10</span>
            <h4>Licensed & Insured</h4>
            <p>Full state contractor licensing with comprehensive general liability coverage.</p>
          </div>
          <div class="highlight-item">
            <span class="hl-num">48A</span>
            <h4>Full-Speed Charging</h4>
            <p>Heavy copper conductors engineered for maximum 11.5 kW output.</p>
          </div>
          <div class="highlight-item">
            <span class="hl-num">25</span>
            <h4>Neighborhood Hubs</h4>
            <p>Dedicated coverage across every residential district in Los Gatos.</p>
          </div>
          <div class="highlight-item">
            <span class="hl-num">100%</span>
            <h4>Code Compliant</h4>
            <p>Permitted and inspected through the Town of Los Gatos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications & Partners Banner -->
  <section class="certifications-banner">
    <div class="container">
      <div class="cert-wrapper">
        <span class="cert-title">Certified Electrical Accreditations:</span>
        <div class="cert-badges">
          <div class="cert-badge-item">California C-10 License #1048291</div>
          <div class="cert-badge-item">Tesla Certified Wall Connector Network</div>
          <div class="cert-badge-item">Town of Los Gatos Building Division</div>
          <div class="cert-badge-item">NEC Article 625 & Title 24 Compliant</div>
          <div class="cert-badge-item">PG&E Service Planning Partner</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section why-us-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">The Local Standard</span>
        <h2>Why Los Gatos Homeowners Rely on Our Electrical Team</h2>
        <p class="section-subtitle">Six core guarantees that ensure your EV charging system is diagnosed accurately and repaired safely.</p>
      </div>

      <div class="features-grid">
        <div class="feature-box">
          <div class="feature-icon">⚡</div>
          <h3>California C-10 Master Electricians</h3>
          <p>Directly employed, background-checked journeyman electricians dedicated to high-voltage residential safety.</p>
        </div>
        <div class="feature-box">
          <div class="feature-icon">⏱️</div>
          <h3>Rapid Los Gatos Dispatch</h3>
          <p>Dispatched from 14165 Capri Drive in Los Gatos for same-day diagnostics and prompt service calls.</p>
        </div>
        <div class="feature-box">
          <div class="feature-icon">📋</div>
          <h3>Town of Los Gatos Permitting</h3>
          <p>We handle all engineering single-lines and coordinate directly with town building inspectors for 100% sign-off.</p>
        </div>
        <div class="feature-box">
          <div class="feature-icon">🛡️</div>
          <h3>Aesthetic & Historic Conduit</h3>
          <p>Concealed crawlspace runs, custom painted raceways, and underground trenching that preserves curb appeal.</p>
        </div>
        <div class="feature-box">
          <div class="feature-icon">🔋</div>
          <h3>Certified for All EV Brands</h3>
          <p>Tesla, Rivian, ChargePoint, Porsche, Ford, BMW, Lucid, Hyundai, and commercial dual-port pedestal units.</p>
        </div>
        <div class="feature-box">
          <div class="feature-icon">📋</div>
          <h3>Transparent Written Proposals</h3>
          <p>Detailed written project specifications with zero surprise hourly creep or hidden material markups.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tailored Project Scopes -->
  <section class="section bg-light pricing-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Repair Solutions</span>
        <h2>Tailored EV Charger Repair Solutions in Los Gatos</h2>
        <p class="section-subtitle">Precision diagnostic testing and certified electrical repairs tailored to your charging station and panel capacity.</p>
      </div>

      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="tier-badge-label">Rapid Diagnostic</div>
          <h3 class="tier-name">Diagnostic & Fault Isolation</h3>
          <p class="tier-desc">Complete multi-point diagnostic testing of failing chargers, nuisance breaker tripping, error code diagnosis, and thermal scan of panel connections.</p>
          <a href="#contact-form" class="btn btn-outline btn-sm">Schedule Diagnostic</a>
        </div>
        <div class="pricing-card">
          <div class="tier-badge-label">Hardware & Receptacle</div>
          <h3 class="tier-name">240V Outlet & Component Repair</h3>
          <p class="tier-desc">Replacement of melted or scorched NEMA 14-50 outlets with industrial Hubbell receptacles, terminal re-torquing, and damaged cable replacements.</p>
          <a href="#contact-form" class="btn btn-primary btn-sm">Request Outlet Repair</a>
        </div>
        <div class="pricing-card">
          <div class="tier-badge-label">Circuit & Breaker</div>
          <h3 class="tier-name">Dedicated Breaker & Conductor Fix</h3>
          <p class="tier-desc">Replacement of fatigued 50A/60A circuit breakers, correction of undersized feeder wiring, conduit repairs, and smart load-shedder integration.</p>
          <a href="#contact-form" class="btn btn-outline btn-sm">Get Circuit Details</a>
        </div>
        <div class="pricing-card">
          <div class="tier-badge-label">Full Restoration</div>
          <h3 class="tier-name">Panel Heavy-Up & Capacity Fix</h3>
          <p class="tier-desc">Resolution of continuous whole-home service panel tripping, bus bar restoration, 200A panel upgrades, and complete surge protection installation.</p>
          <a href="#contact-form" class="btn btn-outline btn-sm">Panel Repair Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Service Process -->
  <section class="section process-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Step-by-Step Workflow</span>
        <h2>Our 4-Step EV Charger Diagnostic & Repair Process</h2>
        <p class="section-subtitle">A methodical, professional workflow from initial service dispatch to full-load verification.</p>
      </div>

      <div class="process-timeline">
        <div class="timeline-step">
          <div class="step-badge">01</div>
          <div class="step-content">
            <h3>Rapid Dispatch & Visual Thermal Audit</h3>
            <p>Our licensed Los Gatos technician arrives with advanced diagnostic instruments to visually inspect conductors and scan panel bus stabs with FLIR thermal imaging.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="step-badge">02</div>
          <div class="step-content">
            <h3>Diagnostic Isolation & Error Code Decoding</h3>
            <p>We test line-to-line voltage, verify ground-fault impedance, and extract factory blink/error codes from Tesla, ChargePoint, or Level 2 control boards.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="step-badge">03</div>
          <div class="step-content">
            <h3>Precision Component Repair & Re-Torquing</h3>
            <p>We replace failing breakers, swap heat-degraded receptacles for industrial Hubbell units, re-pull damaged copper leads, and calibrate torque to manufacturer specs.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="step-badge">04</div>
          <div class="step-content">
            <h3>Continuous Full-Load Stress Testing</h3>
            <p>We initiate a live continuous charging session (up to 48A) to verify voltage stability, thermal balance, and safety shutoff mechanisms before signing off.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="section bg-light" id="problems">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Troubleshooting Specialists</span>
        <h2>Common EV Charging Problems We Solve in Los Gatos</h2>
        <p class="section-subtitle">Don't let electrical failures disrupt your daily commute. We fix every high-voltage charging issue.</p>
      </div>

      <div class="problems-grid">
        {commonProblems.map((prob) => (
          <div class="problem-card">
            <div class="problem-icon">{prob.icon}</div>
            <h3>{prob.title}</h3>
            <p>{prob.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Client Testimonials</span>
        <h2>What Los Gatos Homeowners Say About Our Electrical Service</h2>
        <p class="section-subtitle">Real 5-star reviews from neighbors who trust our licensed electricians.</p>
      </div>

      <div class="testimonials-grid">
        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"Our Tesla Wall Connector stopped charging with a flashing red light on a Sunday morning. Los Gatos EV Charger Pros arrived in 40 minutes, diagnosed a loose terminal lug in the breaker box, re-torqued everything to spec, and had us charging at 48 amps again. Outstanding local service!"</p>
          <div class="review-meta">
            <strong>Marcus S.</strong>
            <span>University Ave, Downtown Los Gatos</span>
          </div>
        </div>
        <div class="review-card">
          <div class="review-stars">★★★★★</div>
