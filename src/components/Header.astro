---
import siteConfig from '../data/site-config.json';
import services from '../data/services.json';
import neighborhoodsList from '../data/neighborhoods-list.json';

const currentPath = Astro.url.pathname;
const featuredNeighborhoods = neighborhoodsList.slice(0, 10);
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a href="/" class="logo" aria-label={`${siteConfig.businessName} - Home`}>
      <span class="logo-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </span>
      <span class="logo-text">
        <span class="logo-name">Los Gatos <span class="logo-green">EV Charger</span></span>
        <span class="logo-sub">Pros & Electric</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/" class:list={["nav-link", { active: currentPath === '/' }]}>Home</a>
        </li>
        <li class="nav-item has-dropdown">
          <a href="/services/" class:list={["nav-link", { active: currentPath.startsWith('/services') }]}>
            Services
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <ul class="dropdown" role="menu">
            {services.map((service) => (
              <li role="menuitem">
                <a href={`/services/${service.slug}/`}>{service.shortName}</a>
              </li>
            ))}
            <li role="menuitem" class="dropdown-all">
              <a href="/services/">All EV Services →</a>
            </li>
          </ul>
        </li>
        <li class="nav-item has-dropdown">
          <a href="/locations/" class:list={["nav-link", { active: currentPath.startsWith('/locations') }]}>
            Locations
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <ul class="dropdown dropdown-locations" role="menu">
            {featuredNeighborhoods.map((n) => (
              <li role="menuitem">
                <a href={`/locations/${n.slug}/`}>{n.name}</a>
              </li>
            ))}
            <li role="menuitem" class="dropdown-all">
              <a href="/locations/">All 25 Neighborhoods & Areas →</a>
            </li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="/about-us/" class:list={["nav-link", { active: currentPath === '/about-us/' }]}>About</a>
        </li>
        <li class="nav-item">
          <a href="/blog/" class:list={["nav-link", { active: currentPath.startsWith('/blog') }]}>Guides & Blog</a>
        </li>
        <li class="nav-item">
          <a href="/contact-us/" class:list={["nav-link", { active: currentPath === '/contact-us/' }]}>Contact</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href={`tel:${siteConfig.phone}`} class="header-phone phone-link" aria-label={`Call us at ${siteConfig.phoneFormatted}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{siteConfig.phoneFormatted}</span>
      </a>
      <a href="/contact-us/" class="btn btn-lime-teal btn-sm header-cta">Get a Quote</a>
    </div>

    <button class="mobile-toggle" id="mobile-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-menu-header">
        <a href="/" class="logo">
          <span class="logo-icon-wrap" style="width: 32px; height: 32px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <span class="logo-text">
            <span class="logo-name">Los Gatos <span class="logo-green">EV Pros</span></span>
          </span>
        </a>
        <button class="mobile-close" id="mobile-close" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation links">
        <a href="/" class="mobile-nav-link">Home</a>

        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger" aria-expanded="false">
            Services
            <svg width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="mobile-accordion-content" hidden>
            {services.map((service) => (
              <a href={`/services/${service.slug}/`} class="mobile-sub-link">{service.shortName}</a>
            ))}
            <a href="/services/" class="mobile-sub-link mobile-sub-all">All Services →</a>
          </div>
        </div>

        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger" aria-expanded="false">
            Locations (Los Gatos Areas)
            <svg width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true"><path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="mobile-accordion-content" hidden>
            {neighborhoodsList.map((n) => (
              <a href={`/locations/${n.slug}/`} class="mobile-sub-link">{n.name}</a>
            ))}
            <a href="/locations/" class="mobile-sub-link mobile-sub-all">All 25 Neighborhoods Hub →</a>
          </div>
        </div>

        <a href="/about-us/" class="mobile-nav-link">About Us</a>
        <a href="/blog/" class="mobile-nav-link">Blog & Guides</a>
        <a href="/contact-us/" class="mobile-nav-link">Contact</a>
      </nav>

      <div class="mobile-menu-footer">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg mobile-phone-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <p class="mobile-hours">Open 24/7 • Emergency EV Charger Repair & Dispatch in Los Gatos</p>
      </div>
    </div>
  </div>
  <div class="mobile-overlay" id="mobile-overlay"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 100);
    background-color: #FFFFFF;
    background-image: linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.95)),
                      url('/images/los-gatos-ev-charger-installation-repair-hero.jpg');
    background-size: cover;
    background-position: center top;
    box-shadow: 0 2px 12px rgba(11, 19, 43, 0.06);
    border-bottom: 1px solid #E2E8F0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    gap: var(--space-4, 1rem);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #FFFFFF;
    border-radius: 10px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .logo:hover .logo-icon-wrap {
    transform: scale(1.08);
  }

  .logo-green {
    color: #10B981;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-name {
    font-family: var(--font-heading, system-ui);
    font-weight: 800;
    font-size: 1.05rem;
    color: #0B132B;
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-family: var(--font-heading, system-ui);
    font-weight: 700;
    font-size: 0.72rem;
    color: #10B981;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    color: #0B132B;
    font-size: 0.925rem;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #10B981;
    background: rgba(16, 185, 129, 0.08);
  }

  .nav-link.active {
    color: #10B981;
    background: rgba(16, 185, 129, 0.1);
    font-weight: 700;
  }

  .nav-link svg {
    transition: transform 0.2s ease;
    color: #64748B;
  }

  .nav-link:hover svg {
    color: #10B981;
  }

  .has-dropdown {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 260px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    box-shadow: 0 16px 36px rgba(11, 19, 43, 0.12);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 1000;
    margin-top: 0.5rem;
    list-style: none;
  }

  .dropdown-locations {
    min-width: 280px;
    max-height: 400px;
    overflow-y: auto;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    margin-top: 0;
  }

  .has-dropdown:hover .nav-link svg {
    transform: rotate(180deg);
  }

  .dropdown li a {
    display: block;
    padding: 0.55rem 0.85rem;
    color: #1E293B;
    font-size: 0.875rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    font-weight: 500;
  }

  .dropdown li a:hover {
    background: #F0FDF4;
    color: #10B981;
    font-weight: 600;
  }

  .dropdown-all a {
    color: #10B981 !important;
    font-weight: 700;
    border-top: 1px solid #E2E8F0;
    margin-top: 0.35rem;
    padding-top: 0.6rem !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .header-phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #0B132B;
    font-weight: 700;
    text-decoration: none;
    background: #F8FAFC;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid #CBD5E1;
    transition: all 0.2s ease;
  }

  .header-phone:hover {
    background: #F0FDF4;
    color: #10B981;
    border-color: #10B981;
  }

  .header-phone svg {
    color: #10B981;
  }

  .header-cta {
    font-weight: 700;
    padding: 0.5rem 1.15rem;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background: #0B132B;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    background: #FFFFFF;
    z-index: 1200;
    transition: right 0.3s ease;
    overflow-y: auto;
  }

  .mobile-menu.open {
    right: 0;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }

  .mobile-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 1.25rem;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #EAEAEA;
    margin-bottom: 1rem;
  }

  .mobile-menu-header .logo-name {
    color: #0B192C;
  }

  .mobile-close {
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: #2D2D2D;
    border-radius: 6px;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem;
    color: #2D2D2D;
    font-size: 1.05rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .mobile-nav-link:hover {
    background: #F5F5F5;
  }

  .mobile-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 600;
    color: #2D2D2D;
    border-radius: 6px;
    text-align: left;
    transition: background 0.15s ease;
  }

  .mobile-accordion-trigger:hover {
    background: #F5F5F5;
  }

  .mobile-accordion-trigger svg {
    transition: transform 0.2s ease;
  }

  .mobile-accordion-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .mobile-accordion-content {
    padding-left: 1rem;
    max-height: 260px;
    overflow-y: auto;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.45rem 0.75rem;
    color: #555555;
    font-size: 0.925rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mobile-sub-link:hover {
    background: #F0F7FF;
    color: #10B981;
  }

  .mobile-sub-all {
    color: #10B981;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .mobile-menu-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid #EAEAEA;
    text-align: center;
  }

  .mobile-phone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem;
    background: #10B981;
    color: #FFFFFF;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
  }

  .mobile-hours {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: #666666;
  }

  @media (max-width: 1024px) {
    .main-nav {
      display: none;
    }
    .header-phone {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header-cta {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const closeBtn = document.getElementById('mobile-close');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');

  function openMenu() {
    menu?.classList.add('open');
    overlay?.classList.add('open');
    menu?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('open');
    overlay?.classList.remove('open');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const content = trigger.nextElementSibling as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (content) {
        content.hidden = isOpen;
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
