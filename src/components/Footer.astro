---
import siteConfig from '../data/site-config.json';
import services from '../data/services.json';
import neighborhoodsList from '../data/neighborhoods-list.json';

const currentYear = new Date().getFullYear();
const topNeighborhoods = neighborhoodsList.slice(0, 8);
---

<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <span class="logo-text">
            <span class="logo-name">Los Gatos <span style="color: #10B981;">EV Charger</span></span>
            <span class="logo-sub">Pros & Electric</span>
          </span>
        </a>
        <p class="footer-tagline">
          Licensed electrical contractors specializing in residential and commercial EV charging stations, Tesla Wall Connectors, 240V circuits, and 200A panel upgrades across Los Gatos, CA.
        </p>
        <div class="footer-contact-info">
          <a href={`tel:${siteConfig.phone}`} class="footer-phone phone-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{siteConfig.phoneFormatted}</span>
          </a>
          <p class="footer-address">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{siteConfig.address.full}</span>
          </p>
          <p class="footer-hours">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{siteConfig.hours}</span>
          </p>
          <p class="footer-zips" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.88rem; color: rgba(255, 255, 255, 0.75);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><strong>Serving Los Gatos ZIP Codes:</strong> 95030, 95031, 95032, 95033</span>
          </p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services/">EV Services Hub</a></li>
          <li><a href="/locations/">Neighborhoods We Serve</a></li>
          <li><a href="/about-us/">About Our Electricians</a></li>
          <li><a href="/blog/">EV Guides & Blog</a></li>
          <li><a href="/contact-us/">Contact & Service Quote</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h4 class="footer-heading">EV Services</h4>
        <ul class="footer-links">
          {services.map((service) => (
            <li>
              <a href={`/services/${service.slug}/`}>{service.shortName}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Neighborhoods -->
      <div class="footer-col">
        <h4 class="footer-heading">Service Areas</h4>
        <ul class="footer-links">
          {topNeighborhoods.map((n) => (
            <li>
              <a href={`/locations/${n.slug}/`}>{n.name}</a>
            </li>
          ))}
          <li>
            <a href="/locations/" class="footer-link-all">All 25 Neighborhoods →</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {currentYear} {siteConfig.businessName}. All rights reserved. California Electrical Contractor License C-10 #1048291.
      </p>
      <div class="footer-badges">
        <span class="footer-badge">Licensed & Insured</span>
        <span class="footer-badge">Los Gatos Local</span>
        <span class="footer-badge">Tesla Certified</span>
        <span class="footer-badge">Title 24 Compliant</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0B132B;
    color: rgba(255, 255, 255, 0.85);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-main {
    padding-block: 4rem 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .footer-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #FFFFFF;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    flex-shrink: 0;
  }

  .footer-logo .logo-name {
    font-family: var(--font-heading, system-ui);
    font-weight: 800;
    font-size: 1.05rem;
    color: #FFFFFF;
  }

  .footer-logo .logo-sub {
    font-family: var(--font-heading, system-ui);
    font-weight: 700;
    font-size: 0.72rem;
    color: #10B981;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .footer-logo .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-phone, .footer-address, .footer-hours {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    text-decoration: none;
  }

  .footer-phone {
    color: #10B981;
    font-weight: 700;
  }

  .footer-phone:hover {
    color: #FFFFFF;
  }

  .footer-heading {
    font-family: var(--font-heading, system-ui);
    font-weight: 700;
    font-size: 0.95rem;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #10B981;
  }

  .footer-link-all {
    color: #10B981 !important;
    font-weight: 700;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 1.25rem;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright {
    font-size: 0.825rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .footer-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.03);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-badges {
      justify-content: center;
    }
  }
</style>
